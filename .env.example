# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq chat model; see https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Authentication (see AUTH.md). Generate values with node scripts/set-password.mjs.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# Must be false in production, with a new password of at least 16 characters.
AUTH_LOCAL_TEST_ONLY=true
